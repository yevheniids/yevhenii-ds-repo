{{- 'sso.css' | asset_url | stylesheet_tag -}}

{%- assign s = section.settings -%}

<sso-login
  data-api-base-url="{{- s.api_base_url -}}"
  class="sso-login__wrapper section section--page-width color-scheme-1"
>
  {%- if s.title != blank -%}
    <h1 class="sso-login__title">
      {{- s.title -}}
    </h1>
  {%- endif -%}

  <form class="sso-login__form" action="#">
    <input type="tel" name="phone" placeholder="Enter your phone number (e.g. +38095)">
    <button type="submit" class="js-send-code">Get code</button>
    <p class="sso-login__error"></p>
  </form>

  <form class="sso-login__form" action="#">
    <input type="text" name="code" placeholder="Enter the code from the SMS">
    <button type="submit" class="js-verify-code">Login</button>
    <p class="sso-login__error"></p>
  </form>
</sso-login>

<script src="{{- 'sso.js' | asset_url -}}" defer></script>

{% schema %}
{
  "name": "SSO",
  "tag": "section",
  "class": "sso-login",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Login via SMS"
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "API Base URL",
      "default": "https://facial-honors-parameter-electro.trycloudflare.com"
    }
  ]
}
{% endschema %}